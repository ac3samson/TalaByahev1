{
  "expo": {
    "name": "TalaByahe",
    "slug": "talabyahe-conductor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.talabyahe.conductor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "with-rn-bluetooth-classic",
        {
          "peripheralUsageDescription": "Allow TalaByahe to connect to Bluetooth thermal printers",
          "alwaysUsageDescription": "Allow TalaByahe to use Bluetooth for receipt printing",
          "protocols": [
            "com.talabyahe.conductor"
          ]
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d338ee1b-fd87-423e-85ab-444c7ad57405"
      }
    }
  }
}
