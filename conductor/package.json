{
  "name": "talabyahe-conductor",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --clear --lan",
    "start:dev": "expo start --dev-client --clear --lan",
    "start:tunnel": "expo start --tunnel ngrok --clear",
    "android": "expo start --android",
    "build:dev": "eas build -p android --profile development",
    "build:apk": "eas build -p android --profile preview",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "babel-preset-expo": "~58.0.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.11",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "patch-package": "^8.0.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "with-rn-bluetooth-classic": "^1.0.5"
  },
  "devDependencies": {
